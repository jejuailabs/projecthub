NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google OAuth credentials are configured in Supabase Auth, not in the browser.
NOTION_WRITE_ENABLED=false
TEXT_EXTRACTION_ENABLED=false
TOKEN_ENCRYPTION_KEY=
TOKEN_KEY_VERSION=1
OPENAI_API_KEY=
OPENAI_EXTRACTION_MODEL=gpt-6-luna
CRON_SECRET=

# Alternate OpenAI key name (server only)
LLM_PROVIDER=openai
LLM_PROVIDER_API_KEY=

# External integrations: server-only OAuth app credentials. See docs/16-integrations.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
VERCEL_CLIENT_ID=
VERCEL_CLIENT_SECRET=
VERCEL_INTEGRATION_SLUG=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Google login setup values (server-side setup reference only).
# Also configure these in Supabase Authentication > Google and enable the provider.
# Adding these to Vercel alone does NOT enable Supabase Google login.
# Google authorized redirect URI: https://tcodixafsipheefvuouc.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
